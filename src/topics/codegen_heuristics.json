{
  "title": "Codegen Heuristics",
  "tagline": "Compare optimization strategies by their expected compile-time cost as program size grows.",
  "xAxisLabel": "Program Size (n)",
  "yAxisLabel": "Relative Compile Cost (0-100+)",
  "curves": [
    {
      "id": "1",
      "label": "Local Peephole",
      "color": "#2D7FF9",
      "formula": "n => 0.02*n + 5",
      "code": "function peephole(n){ return 0.02*n + 5; }",
      "name": "Local Peephole"
    },
    {
      "id": "2",
      "label": "SSA Value Numbering",
      "color": "#00D1B2",
      "formula": "n => 0.0006*n*Math.log2(Math.max(2,n)) + 8",
      "code": "function ssaValueNumbering(n){ return 0.0006*n*Math.log2(Math.max(2,n)) + 8; }",
      "name": "SSA Value Numbering"
    },
    {
      "id": "3",
      "label": "Global Register Allocation",
      "color": "#FF6A00",
      "formula": "n => 0.003*n*n + 10",
      "code": "function regAlloc(n){ return 0.003*n*n + 10; }",
      "name": "Global Register Allocation"
    },
    {
      "id": "4",
      "label": "Polyhedral Tiling Search",
      "color": "#7A3CFF",
      "formula": "n => 0.000001*n*n*n + 12",
      "code": "function polyhedralSearch(n){ return 0.000001*n*n*n + 12; }",
      "name": "Polyhedral Tiling Search"
    },
    {
      "id": "5",
      "label": "Profile-Guided Reopt",
      "color": "#22C55E",
      "formula": "n => 0.01*n*Math.log2(Math.max(2,n))*Math.log2(Math.max(2,n)) + 6",
      "code": "function pgoReopt(n){ const L=Math.log2(Math.max(2,n)); return 0.01*n*L*L + 6; }",
      "name": "Profile-Guided Reopt"
    }
  ]
}