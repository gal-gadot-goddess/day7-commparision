{
  "title": "Foveated Streaming",
  "tagline": "Three gaze-aware encoding strategies trade bitrate, latency, and quality in distinct ways.",
  "xAxisLabel": "Viewport entropy factor (n)",
  "yAxisLabel": "Total cost (ms * % bitrate)",
  "curves": [
    {
      "id": "1",
      "label": "Uniform Tiling",
      "color": "#00D1FF",
      "formula": "n => 1.2 * n + 0.4 * n * Math.log(n + 1)",
      "code": "function uniformTiling(n){ return 1.2*n + 0.4*n*Math.log(n+1); }",
      "name": "Uniform Tiling"
    },
    {
      "id": "2",
      "label": "Gaze-Weighted ROI",
      "color": "#7CFF00",
      "formula": "n => 0.85 * n + 5.5 * Math.sqrt(n) + 0.12 * n * Math.log(n + 1)",
      "code": "function gazeWeightedROI(n){ return 0.85*n + 5.5*Math.sqrt(n) + 0.12*n*Math.log(n+1); }",
      "name": "Gaze-Weighted ROI"
    },
    {
      "id": "3",
      "label": "Predictive Beam Budgeting",
      "color": "#FF7A00",
      "formula": "n => 0.95 * n + 14 * Math.log(n + 1) + 0.03 * n * n",
      "code": "function predictiveBeamBudgeting(n){ return 0.95*n + 14*Math.log(n+1) + 0.03*n*n; }",
      "name": "Predictive Beam Budgeting"
    },
    {
      "id": "4",
      "label": "Multi-Model Tile Inference",
      "color": "#A100FF",
      "formula": "n => 0.35 * n * n + 6 * n + 2.2 * Math.log(n + 1)",
      "code": "function multiModelTileInference(n){ return 0.35*n*n + 6*n + 2.2*Math.log(n+1); }",
      "name": "Multi-Model Tile Inference"
    }
  ]
}