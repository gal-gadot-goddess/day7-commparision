{
  "title": "Merkleless Attestation",
  "tagline": "Compare four verification strategies for tamper-evident logs without Merkle-style trees.",
  "xAxisLabel": "Log length (n) with fixed record size",
  "yAxisLabel": "Verification cost (0-100+)",
  "curves": [
    {
      "id": "1",
      "label": "Full Replay",
      "color": "#FF4D4D",
      "formula": "n => 0.02 * n*n + 0.3*n + 1",
      "code": "for(let i=0;i<n;i++){hashState=hashState.update(records[i]);} return hashState;",
      "name": "Full Replay"
    },
    {
      "id": "2",
      "label": "Chained Signatures",
      "color": "#00C2FF",
      "formula": "n => 0.15 * n + 5",
      "code": "for(let i=1;i<n;i++){verifySignature(sig[i], records[i], hash(records[i-1]));}",
      "name": "Chained Signatures"
    },
    {
      "id": "3",
      "label": "K-Min Hash Checkpoints",
      "color": "#7CFF6B",
      "formula": "n => 0.1 * (n*Math.log2(n)) + 2*n/50 + 8",
      "code": "for(let i=0;i<k;i++){idx=checkpointIndex(i,n); compareDigest(idx);} verifyLinksBetweenCheckpoints();",
      "name": "K-Min Hash Checkpoints"
    },
    {
      "id": "4",
      "label": "Homomorphic Aggregate Proof",
      "color": "#FFD000",
      "formula": "n => 0.25 * Math.pow(n,0.5) * (Math.log2(n)+1) + 30",
      "code": "agg=aggregateWitness(records, secret); proof=prove(agg); verify(proof);",
      "name": "Homomorphic Aggregate Proof"
    },
    {
      "id": "5",
      "label": "Batch Linear Verifier",
      "color": "#8A2BE2",
      "formula": "n => 0.03 * n*Math.log2(n) + 0.7*n + 12",
      "code": "prepareBatches(records); solveLinearConstraints(batches); verifyAllConstraints();",
      "name": "Batch Linear Verifier"
    }
  ]
}