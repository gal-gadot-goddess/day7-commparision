{
  "title": "N-Gram Smoothing",
  "tagline": "Compare five smoothing strategies for estimating unseen language probabilities from limited counts.",
  "xAxisLabel": "Training corpus size (n)",
  "yAxisLabel": "Expected perplexity (0-100+)",
  "curves": [
    {
      "id": "1",
      "label": "Add-One (Laplace)",
      "color": "#FF4D4D",
      "formula": "n => 12 + 90 / (n + 1)",
      "code": "for(let n=1;n<=N;n++){ let y=12+90/(n+1); push(y); }",
      "name": "Add-One (Laplace)"
    },
    {
      "id": "2",
      "label": "Add-δ (Lidstone)",
      "color": "#FFB84D",
      "formula": "n => 10 + 70 / Math.pow(n + 2, 0.75)",
      "code": "for(let n=1;n<=N;n++){ let y=10+70/Math.pow(n+2,0.75); push(y); }",
      "name": "Add-δ (Lidstone)"
    },
    {
      "id": "3",
      "label": "Good-Turing",
      "color": "#4DFF88",
      "formula": "n => 8 + 60 / Math.sqrt(n + 3)",
      "code": "for(let n=1;n<=N;n++){ let y=8+60/Math.sqrt(n+3); push(y); }",
      "name": "Good-Turing"
    },
    {
      "id": "4",
      "label": "Kneser-Ney (Basic)",
      "color": "#4DB3FF",
      "formula": "n => 6 + 35 * Math.log(n + 1) / (n + 1)",
      "code": "for(let n=1;n<=N;n++){ let y=6 + 35*Math.log(n+1)/(n+1); push(y); }",
      "name": "Kneser-Ney (Basic)"
    },
    {
      "id": "5",
      "label": "Witten-Bell (Adaptive)",
      "color": "#B84DFF",
      "formula": "n => 7 + 45 / Math.log(n + 2) ",
      "code": "for(let n=2;n<=N;n++){ let y=7+45/Math.log(n+2); push(y); }",
      "name": "Witten-Bell (Adaptive)"
    }
  ]
}