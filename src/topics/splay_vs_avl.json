{
  "title": "Splay vs AVL",
  "tagline": "How different self-adjusting tree strategies reshape search costs and rotations over time.",
  "xAxisLabel": "Number of operations (n)",
  "yAxisLabel": "Estimated time units (0-100 scale)",
  "curves": [
    {
      "id": "1",
      "label": "Splay Tree (Amortized)",
      "color": "#7CFF6B",
      "formula": "n => 0.22 * n * Math.log2(n + 1)",
      "code": "for(step=0; step<n; step++){ access(x); splay(x); }",
      "name": "Splay Tree (Amortized)"
    },
    {
      "id": "2",
      "label": "AVL Tree (Strict Balancing)",
      "color": "#4DA6FF",
      "formula": "n => 0.18 * n * Math.log2(n + 1) + 0.02 * n",
      "code": "for(step=0; step<n; step++){ insertOrFind(x); rebalanceAVL(); }",
      "name": "AVL Tree (Strict Balancing)"
    },
    {
      "id": "3",
      "label": "Red-Black Tree (Relaxed Balancing)",
      "color": "#FFB84D",
      "formula": "n => 0.15 * n * Math.log2(n + 1) + 0.05 * Math.sqrt(n)",
      "code": "for(step=0; step<n; step++){ insertOrFind(x); fixRBProperties(); }",
      "name": "Red-Black Tree (Relaxed Balancing)"
    },
    {
      "id": "4",
      "label": "Unbalanced BST (Worst-Case)",
      "color": "#FF4D6D",
      "formula": "n => 0.002 * n * n",
      "code": "for(step=0; step<n; step++){ insertOrFindSorted(x); /* degenerates */ }",
      "name": "Unbalanced BST (Worst-Case)"
    }
  ]
}