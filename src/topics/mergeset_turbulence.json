{
  "title": "Mergeset Turbulence",
  "tagline": "Compare four strategies for multiway merging when run lengths are irregular and the number of runs grows.",
  "xAxisLabel": "Number of Runs (k)",
  "yAxisLabel": "Estimated Merge Cost (0-100+)",
  "curves": [
    {
      "id": "1",
      "label": "Repeated Two-Way Merge",
      "color": "#FF2D55",
      "formula": "k => 0.02 * k*k + 0.5 * Math.pow(k, 1.5)",
      "code": "function costTwoWay(k){let cost=0; for(let i=1;i<k;i++){cost += i; } return 0.02*k*k + 0.5*Math.pow(k,1.5);}",
      "name": "Repeated Two-Way Merge"
    },
    {
      "id": "2",
      "label": "Tournament Tree Merge",
      "color": "#34C759",
      "formula": "k => 0.8 * k * Math.log2(Math.max(2,k)) + 0.05 * k*k",
      "code": "function costTournament(k){let t=Math.log2(Math.max(2,k)); return 0.8*k*t + 0.05*k*k;}",
      "name": "Tournament Tree Merge"
    },
    {
      "id": "3",
      "label": "Loser Tree Merge",
      "color": "#0A84FF",
      "formula": "k => 0.55 * k * Math.log2(Math.max(2,k))",
      "code": "function costLoser(k){return 0.55*k*Math.log2(Math.max(2,k));}",
      "name": "Loser Tree Merge"
    },
    {
      "id": "4",
      "label": "Bitonic Merge Network",
      "color": "#FF9500",
      "formula": "k => 0.02 * k*Math.log2(Math.max(2,k))**2 + 0.05*Math.pow(k,1.8)",
      "code": "function costBitonic(k){let L=Math.log2(Math.max(2,k)); return 0.02*k*Math.pow(L,2)+0.05*Math.pow(k,1.8);}",
      "name": "Bitonic Merge Network"
    }
  ]
}