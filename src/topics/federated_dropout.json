{
  "title": "Federated Dropout",
  "tagline": "Compare three client update compression schemes versus uncompressed training under heterogeneous noise.",
  "xAxisLabel": "Client update size / parameters (n)",
  "yAxisLabel": "Total wall-clock latency (ms)",
  "curves": [
    {
      "id": "1",
      "label": "Raw Gradients",
      "color": "#FF3B30",
      "formula": "n => 0.06*n + 8",
      "code": "simulateRaw(n){ return 0.06*n + 8 }",
      "name": "Raw Gradients"
    },
    {
      "id": "2",
      "label": "Top-k Sparsification",
      "color": "#34C759",
      "formula": "n => 0.09*n + 0.02*n*Math.log2(n+1) + 10",
      "code": "simulateTopK(n){ return 0.09*n + 0.02*n*Math.log2(n+1) + 10 }",
      "name": "Top-k Sparsification"
    },
    {
      "id": "3",
      "label": "Sign-Only Updates (1-bit)",
      "color": "#0A84FF",
      "formula": "n => 5 + 0.015*n*Math.log2(n+1) + 0.0002*n*n",
      "code": "simulateSign1Bit(n){ return 5 + 0.015*n*Math.log2(n+1) + 0.0002*n*n }",
      "name": "Sign-Only Updates (1-bit)"
    },
    {
      "id": "4",
      "label": "Entropy-Coded Residuals",
      "color": "#FF9500",
      "formula": "n => 2 + 0.04*n + 7*Math.log2(n+1) + 0.000001*n*n",
      "code": "simulateEntropyResiduals(n){ return 2 + 0.04*n + 7*Math.log2(n+1) + 0.000001*n*n }",
      "name": "Entropy-Coded Residuals"
    }
  ]
}