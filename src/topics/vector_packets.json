{
  "title": "Vector Packets",
  "tagline": "Compare four packetization strategies by their total overhead growth as payload size increases.",
  "xAxisLabel": "Payload size n (bytes, log-scaled in renderer)",
  "yAxisLabel": "Total overhead (0-100 scale normalized)",
  "curves": [
    {
      "id": "1",
      "label": "Fixed-Header",
      "color": "#00D1FF",
      "formula": "n => (2 + 0.02*n) / (0.02*n + 2) * 100",
      "code": "overhead = 2 + 0.02*n; total = 1*overhead/(0.02*n+2)*100;",
      "name": "Fixed-Header"
    },
    {
      "id": "2",
      "label": "TLV Varint Header",
      "color": "#7CFF6B",
      "formula": "n => (1.5 + 0.8*Math.log2(n+1) + 0.02*(n/8)) / (1.5 + 0.8*Math.log2(n+1) + 0.02*(n/8)) * 100",
      "code": "overhead = 1.5 + 0.8*Math.log2(n+1) + 0.02*(n/8); total = overhead/(overhead)*100;",
      "name": "TLV Varint Header"
    },
    {
      "id": "3",
      "label": "Fragment + Reassembly",
      "color": "#FFB000",
      "formula": "n => Math.min(100, (0.5 + 0.15*(n/512) + 0.0002*Math.pow(n,1.25)) )",
      "code": "fragments = n/512; overhead = 0.5 + 0.15*fragments + 0.0002*Math.pow(n,1.25); total = overhead;",
      "name": "Fragment + Reassembly"
    },
    {
      "id": "4",
      "label": "Sliding Window ACKs",
      "color": "#8A2BE2",
      "formula": "n => (0.8 + 0.05*Math.pow(n,1.3) + 0.001*Math.pow(n,2)/ (n+100) )/ (0.8 + 0.05*Math.pow(n,1.3) + 0.001*Math.pow(n,2)/ (n+100) ) * 100",
      "code": "overhead = 0.8 + 0.05*Math.pow(n,1.3) + 0.001*(n*n)/(n+100); total = overhead/(overhead)*100;",
      "name": "Sliding Window ACKs"
    }
  ]
}