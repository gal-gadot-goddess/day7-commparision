{
  "title": "Torque-Trim Routing",
  "tagline": "Compare four packet routing strategies by how they grow end-to-end latency as traffic increases.",
  "xAxisLabel": "Concurrent Flows (n)",
  "yAxisLabel": "End-to-End Latency (ms)",
  "curves": [
    {
      "id": "1",
      "label": "Dimension-Ordered Routing",
      "color": "#00D1FF",
      "formula": "n => 5 + 0.6 * Math.log2(n + 1)",
      "code": "latency=5+0.6*Math.log2(n+1); return latency;",
      "name": "Dimension-Ordered Routing"
    },
    {
      "id": "2",
      "label": "U-turn-Free Adaptive Routing",
      "color": "#7CFF00",
      "formula": "n => 7 + 0.9 * Math.pow(n, 1.15)",
      "code": "latency=7+0.9*Math.pow(n,1.15); return latency;",
      "name": "U-turn-Free Adaptive Routing"
    },
    {
      "id": "3",
      "label": "Valiant Random Routing",
      "color": "#FF6A00",
      "formula": "n => 10 + 0.02 * n * n",
      "code": "latency=10+0.02*n*n; return latency;",
      "name": "Valiant Random Routing"
    },
    {
      "id": "4",
      "label": "Opportunistic Cut-Through",
      "color": "#A100FF",
      "formula": "n => 6 + 0.12 * n * Math.log2(n + 1)",
      "code": "latency=6+0.12*n*Math.log2(n+1); return latency;",
      "name": "Opportunistic Cut-Through"
    }
  ]
}