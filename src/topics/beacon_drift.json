{
  "title": "Beacon Drift",
  "tagline": "Compare synchronization schemes by how their timing error grows under noisy clock offsets.",
  "xAxisLabel": "Number of Sync Cycles (n)",
  "yAxisLabel": "Cumulative Timing Error (0-100+)",
  "curves": [
    {
      "id": "1",
      "label": "Raw Timestamping",
      "color": "#00E5FF",
      "formula": "n => 0.2 * n",
      "code": "let t=0; for(let i=0;i<n;i++){ t += 0.2; } return t;",
      "name": "Raw Timestamping"
    },
    {
      "id": "2",
      "label": "Averaging Phase Lock",
      "color": "#7CFF6B",
      "formula": "n => 0.9 * Math.log(n+1)",
      "code": "return 0.9 * Math.log(n+1);",
      "name": "Averaging Phase Lock"
    },
    {
      "id": "3",
      "label": "Kalman Clock Filter",
      "color": "#FFB300",
      "formula": "n => 1.2 * Math.sqrt(n)",
      "code": "let e=0; for(let i=1;i<=n;i++){ e += 1.2/Math.sqrt(i); } return 1.2*Math.sqrt(n);",
      "name": "Kalman Clock Filter"
    },
    {
      "id": "4",
      "label": "Hierarchical Two-Hop Sync",
      "color": "#FF3D71",
      "formula": "n => 0.05 * n * n / (n+1)",
      "code": "return 0.05 * n*n/(n+1);",
      "name": "Hierarchical Two-Hop Sync"
    },
    {
      "id": "5",
      "label": "Dispersive Gossip Resync",
      "color": "#8A2BE2",
      "formula": "n => 0.02 * n * (Math.log(n+1)+1)",
      "code": "return 0.02 * n * (Math.log(n+1)+1);",
      "name": "Dispersive Gossip Resync"
    }
  ]
}