{
  "title": "Packet Cloaking",
  "tagline": "Compare transport-layer methods that trade secrecy and latency under adversarial traffic analysis.",
  "xAxisLabel": "Message Size (n, bytes) + Queue Depth (d)",
  "yAxisLabel": "Total Cost (0-100+ scaled)",
  "curves": [
    {
      "id": "1",
      "label": "Plaintext + Timing",
      "color": "#2E86AB",
      "formula": "n => 10 + 0.00008*n*n",
      "code": "send(msg){ wire.send(msg); observeTiming(); }",
      "name": "Plaintext + Timing"
    },
    {
      "id": "2",
      "label": "Encrypted Stream (TLS-style)",
      "color": "#F18F01",
      "formula": "n => 15 + 0.03*Math.log2(n+1) + 0.00012*n",
      "code": "encryptInPlace(buf); frame=record(buf); wire.send(frame);",
      "name": "Encrypted Stream (TLS-style)"
    },
    {
      "id": "3",
      "label": "Onion Relaying (Multi-hop)",
      "color": "#7B2CBF",
      "formula": "n => 25 + 0.1*(Math.log2(n+1))*(Math.log2(n+1)) + 0.0002*n + 6",
      "code": "for(hops){ wrapLayer(msg,hKey); msg=relay(msg); }",
      "name": "Onion Relaying (Multi-hop)"
    },
    {
      "id": "4",
      "label": "Mix-Network Batching",
      "color": "#00A878",
      "formula": "n => 20 + 0.15*Math.sqrt(n) + 0.001*n*Math.log2(n+1) + 10",
      "code": "enqueue(msg); if(batchFull){ shuffle(batch); flush(batch);} ",
      "name": "Mix-Network Batching"
    },
    {
      "id": "5",
      "label": "Cover-Traffic Obfuscation",
      "color": "#D7263D",
      "formula": "n => 18 + 0.08*(n) + 0.04*(n) + 12*Math.log2(n+1) + 50",
      "code": "targetRate=...; while(time<deadline){ if(realMsg){ send(realMsg);} else {send(padding);} }",
      "name": "Cover-Traffic Obfuscation"
    }
  ]
}