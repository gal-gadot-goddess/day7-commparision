{
  "title": "Merkle-Free Sync",
  "tagline": "Compare verification-free reconciliation versus probabilistic and deterministic consistency checks.",
  "xAxisLabel": "Update Count (n)",
  "yAxisLabel": "Work / Risk Score (0-100+)",
  "curves": [
    {
      "id": "1",
      "label": "Naive Full Recheck",
      "color": "#FF2D55",
      "formula": "n => 0.08 * n * n + 0.6 * n",
      "code": "for(let i=0;i<n;i++){ for(let j=0;j<n;j++){ verify(i,j); } }",
      "name": "Naive Full Recheck"
    },
    {
      "id": "2",
      "label": "Incremental Checksum Chain",
      "color": "#00D4FF",
      "formula": "n => 0.9 * n + 5 * Math.log(n + 1)",
      "code": "let s=seed; for(let i=0;i<n;i++){ s = (s*1315423911 + data[i])>>>0; } return s;",
      "name": "Incremental Checksum Chain"
    },
    {
      "id": "3",
      "label": "Bloom-Like Soft Consistency",
      "color": "#7CFF00",
      "formula": "n => 0.6 * n * (Math.log(n + 1)) / Math.log(2) + 8 * Math.pow(1 - Math.exp(-0.12*n), 2)",
      "code": "for(let i=0;i<n;i++){ for(let k=0;k<K;k++){ bits[hash(i,k)%m]=1; } }",
      "name": "Bloom-Like Soft Consistency"
    },
    {
      "id": "4",
      "label": "Reversible Diff Reconciliation",
      "color": "#9B5CFF",
      "formula": "n => 0.15 * n * Math.log(n + 1) + 2 + 10*Math.pow(Math.sin(n/17),2)",
      "code": "buildEditScript(a,b); applyForward(); verifyLocally(); applyInverse();",
      "name": "Reversible Diff Reconciliation"
    },
    {
      "id": "5",
      "label": "Deterministic Partition Proof",
      "color": "#FFB800",
      "formula": "n => 0.02 * n*n*Math.log(n + 1) + 0.5*n + 3",
      "code": "let parts=Math.ceil(Math.sqrt(n)); for(let p=0;p<parts;p++){ for(let i=0;i<n/parts;i++){ prove(p,i);} }",
      "name": "Deterministic Partition Proof"
    }
  ]
}