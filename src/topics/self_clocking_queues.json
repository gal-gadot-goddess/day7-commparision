{
  "title": "Self-Clocking Queues",
  "tagline": "Compare four admission controllers for controlling queue growth under bursty arrivals using self-timed signaling.",
  "xAxisLabel": "Load Factor (ρ = λ/μ)",
  "yAxisLabel": "Queueing Delay Score (0–100+)",
  "curves": [
    {
      "id": "1",
      "label": "Static Threshold Gate",
      "color": "#FF2D55",
      "formula": "rho => 100 * (1 / (1 + Math.exp(-10 * (rho - 0.72)))) + 18 * Math.max(0, (rho - 0.72))",
      "code": "function score(rho){return 100*(1/(1+Math.exp(-10*(rho-0.72)))) + 18*Math.max(0,rho-0.72);}",
      "name": "Static Threshold Gate"
    },
    {
      "id": "2",
      "label": "PID Backpressure",
      "color": "#00D1FF",
      "formula": "rho => 12 + 85 * Math.pow(rho, 6) + 30 * Math.pow(Math.max(0, rho - 0.85), 2)",
      "code": "function score(rho){return 12 + 85*Math.pow(rho,6) + 30*Math.pow(Math.max(0,rho-0.85),2);}",
      "name": "PID Backpressure"
    },
    {
      "id": "3",
      "label": "Token Bucket Shaper",
      "color": "#7CFF6B",
      "formula": "rho => 10 + 65 * (rho / (1 - rho + 0.02)) * (0.25 + 0.75*Math.tanh(6*(rho-0.55)))",
      "code": "function score(rho){return 10 + 65*(rho/(1-rho+0.02))*(0.25+0.75*Math.tanh(6*(rho-0.55)));}",
      "name": "Token Bucket Shaper"
    },
    {
      "id": "4",
      "label": "Self-Clocked AIMD",
      "color": "#FFD166",
      "formula": "rho => 8 + 55 * Math.log(1 + 10*rho) + 95 * Math.max(0, rho - 0.9) * Math.pow(rho, 2)",
      "code": "function score(rho){return 8 + 55*Math.log(1+10*rho) + 95*Math.max(0,rho-0.9)*Math.pow(rho,2);}",
      "name": "Self-Clocked AIMD"
    },
    {
      "id": "5",
      "label": "Multiplicative Deflection",
      "color": "#9B5CFF",
      "formula": "rho => 6 + 30*Math.pow(rho, 3) + 170 * Math.pow(Math.max(0, rho - 0.6), 2) / (0.08 + (1-rho))",
      "code": "function score(rho){return 6 + 30*Math.pow(rho,3) + 170*Math.pow(Math.max(0,rho-0.6),2)/(0.08+(1-rho));}",
      "name": "Multiplicative Deflection"
    }
  ]
}