{
  "title": "Merkle Forest",
  "tagline": "Compare four integrity strategies for incremental filesystem snapshots under chunk churn and audit queries.",
  "xAxisLabel": "Dataset churn (updated chunks)",
  "yAxisLabel": "Total verification cost (0-100+ normalized)",
  "curves": [
    {
      "id": "1",
      "label": "Rebuild Merkle Tree",
      "color": "#7C4DFF",
      "formula": "c => 8 + 0.02 * c * c + 0.6 * Math.log2(c + 2)",
      "code": "function cost(c){ return 8 + 0.02*c*c + 0.6*Math.log2(c+2); }",
      "name": "Rebuild Merkle Tree"
    },
    {
      "id": "2",
      "label": "Merkle Forest (Chunked Roots)",
      "color": "#00E5FF",
      "formula": "c => 6 + 0.18 * Math.log2(c + 2) * Math.sqrt(c + 1)",
      "code": "function cost(c){ return 6 + 0.18*Math.log2(c+2)*Math.sqrt(c+1); }",
      "name": "Merkle Forest (Chunked Roots)"
    },
    {
      "id": "3",
      "label": "Authenticated Segment DAG",
      "color": "#00C853",
      "formula": "c => 4 + 0.9 * Math.log2(c + 2) + 0.03 * c",
      "code": "function cost(c){ return 4 + 0.9*Math.log2(c+2) + 0.03*c; }",
      "name": "Authenticated Segment DAG"
    },
    {
      "id": "4",
      "label": "Bloomed Checkpoints",
      "color": "#FFAB00",
      "formula": "c => 10 + 0.55 * Math.log2(c + 2) + 0.8 * Math.sqrt(c + 1) + 0.002 * c * c",
      "code": "function cost(c){ return 10 + 0.55*Math.log2(c+2) + 0.8*Math.sqrt(c+1) + 0.002*c*c; }",
      "name": "Bloomed Checkpoints"
    },
    {
      "id": "5",
      "label": "Full Byte Re-Scan",
      "color": "#FF1744",
      "formula": "c => 20 + 0.12 * c + 0.06 * c * Math.log2(c + 2)",
      "code": "function cost(c){ return 20 + 0.12*c + 0.06*c*Math.log2(c+2); }",
      "name": "Full Byte Re-Scan"
    }
  ]
}