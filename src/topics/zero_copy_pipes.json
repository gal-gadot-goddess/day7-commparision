{
  "title": "Zero-Copy Pipes",
  "tagline": "Compare four IPC strategies by how their cost grows with message volume and size.",
  "xAxisLabel": "Message Count (n) + Size Factor (m/n)",
  "yAxisLabel": "Total Overhead Score (0-100+)",
  "curves": [
    {
      "id": "1",
      "label": "Copying Syscalls",
      "color": "#FF4D4D",
      "formula": "n => 0.02*n*n + 0.35*n + 10",
      "code": "const overhead = 0.02*n*n + 0.35*n + 10; return overhead;",
      "name": "Copying Syscalls"
    },
    {
      "id": "2",
      "label": "Shared-Memory Ring",
      "color": "#00E5FF",
      "formula": "n => 0.9*n + 12*Math.log(n+1)",
      "code": "const overhead = 0.9*n + 12*Math.log(n+1); return overhead;",
      "name": "Shared-Memory Ring"
    },
    {
      "id": "3",
      "label": "IOUring Batching",
      "color": "#7CFF00",
      "formula": "n => 0.08*n*Math.log(n+1) + 18",
      "code": "const overhead = 0.08*n*Math.log(n+1) + 18; return overhead;",
      "name": "IOUring Batching"
    },
    {
      "id": "4",
      "label": "Kernel Page Remap",
      "color": "#A855F7",
      "formula": "n => 0.45*n + 6*Math.log(n+1) + 3*(Math.sqrt(n))",
      "code": "const overhead = 0.45*n + 6*Math.log(n+1) + 3*Math.sqrt(n); return overhead;",
      "name": "Kernel Page Remap"
    },
    {
      "id": "5",
      "label": "User-Space Shared Queues",
      "color": "#FFB800",
      "formula": "n => 0.03*n*n*Math.pow(Math.log(n+1),0.5) + 20",
      "code": "const overhead = 0.03*n*n*Math.pow(Math.log(n+1),0.5) + 20; return overhead;",
      "name": "User-Space Shared Queues"
    }
  ]
}