{
  "title": "Dynamic SCC Lens",
  "tagline": "Compare four incremental algorithms for tracking strongly connected components as edges stream in.",
  "xAxisLabel": "Edge Updates (m)",
  "yAxisLabel": "Total Recompute Cost (ms)",
  "curves": [
    {
      "id": "1",
      "label": "Full Tarjan Recompute",
      "color": "#7C4DFF",
      "formula": "m => 0.00002 * (m*m) + 0.12 * m",
      "code": "for (let k=0;k<m;k++){ addEdge(); tarjanSCC(); }",
      "name": "Full Tarjan Recompute"
    },
    {
      "id": "2",
      "label": "Incremental Condensation Repair",
      "color": "#00E5FF",
      "formula": "m => 0.02 * m * Math.log2(m+1) + 0.4*m",
      "code": "for (let k=0;k<m;k++){ addEdge(u,v); updateCondensationDAG(); repairAffectedSCCs(); }",
      "name": "Incremental Condensation Repair"
    },
    {
      "id": "3",
      "label": "DSU-on-Transpose Batch Union",
      "color": "#4CAF50",
      "formula": "m => 0.06 * m * Math.log2(m+1) + 0.08*m*m/(m+1)",
      "code": "batch edges; for each batch: union in original and transpose graphs; rebuild SCCs for touched nodes.",
      "name": "DSU-on-Transpose Batch Union"
    },
    {
      "id": "4",
      "label": "Online SCC via Link-Cut Decomposition",
      "color": "#FF6D00",
      "formula": "m => 0.5 * m * Math.pow(Math.log2(m+1),2) + 0.2*m",
      "code": "for (let k=0;k<m;k++){ addEdge(u,v); updateDynamicForest(); maintainSCCIntervals(); }",
      "name": "Online SCC via Link-Cut Decomposition"
    }
  ]
}